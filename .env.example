# Copie este arquivo para .env e preencha com os valores do SEU projeto.
# Nunca commite o .env. Não coloque chaves reais neste exemplo.

# O aplicativo Expo só embute variáveis que começam com EXPO_PUBLIC_.
# Use apenas a URL do projeto e a chave anon (pública) do Supabase.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_PRIVACY_CONTACT_EMAIL=
# Tamanho máximo de upload em bytes. O plano gratuito do Supabase aceita 52428800 (50 MB).
EXPO_PUBLIC_MAX_UPLOAD_BYTES=52428800

# A chave publicável da Stripe pode ir no app. Ela não autoriza cobranças.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Nomes usados na documentação e nas Edge Functions.
# Repita a URL e a chave anon abaixo para o servidor.
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET e SUPABASE_SERVICE_ROLE_KEY
# são segredos de servidor. Configure-os com `supabase secrets set`.
# Não os referencie no código do aplicativo.
SUPABASE_URL=
SUPABASE_ANON_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
